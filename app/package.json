{
  "name": "@lucent/electron",
  "productName": "Lucent",
  "version": "0.0.4",
  "main": "dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/toommyliu/lucent.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p src/main/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "node esbuild.config.js",
    "compile:watch": "node esbuild.config.js --watch",
    "compile:prod": "cross-env NODE_ENV=production node esbuild.config.js",
    "electron": "node scripts/start-electron.mjs",
    "build": "pnpm run compile:prod",
    "electron-builder": "electron-builder"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@lucent/core": "workspace:*",
    "@lucent/game": "workspace:*",
    "@lucent/ui": "workspace:*",
    "@lucent/ui-react": "workspace:*",
    "@tanstack/solid-hotkeys": "^0.10.0",
    "@tanstack/solid-virtual": "3.13.24",
    "acorn": "8.16.0",
    "effect": "4.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "7.7.4",
    "solid-js": "^1.9.12",
    "tar": "7.5.22",
    "ws": "^8.21.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.7.1",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.0.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-solid": "^0.6.0",
    "tsx": "^4.19.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
