{
  "name": "@lucent/electron",
  "productName": "Lucent",
  "version": "0.0.4",
  "main": "dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/toommyliu/lucent.git"
  },
  "scripts": {
    "polyfills:check": "tsx scripts/gen-core-js-polyfills.ts --check",
    "polyfills:generate": "tsx scripts/gen-core-js-polyfills.ts",
    "prepare": "pnpm polyfills:generate",
    "typecheck": "tsc --noEmit && tsc -p src/main/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "observability:build": "pnpm --dir ../observability build",
    "compile": "node esbuild.config.js",
    "compile:watch": "node esbuild.config.js --watch",
    "compile:prod": "pnpm run observability:build && cross-env NODE_ENV=production node esbuild.config.js",
    "electron": "node scripts/start-electron.mjs",
    "build": "pnpm run compile:prod",
    "electron-builder": "electron-builder"
  },
  "dependencies": {
    "@lucent/core": "workspace:*",
    "@lucent/game": "workspace:*",
    "@lucent/ui": "workspace:*",
    "@tanstack/solid-hotkeys": "^0.10.0",
    "@tanstack/solid-virtual": "3.13.24",
    "abort-controller": "^3.0.0",
    "acorn": "8.16.0",
    "core-js": "3.49.0",
    "effect": "4.0.0-rc.112",
    "semver": "7.7.4",
    "solid-js": "^1.9.12",
    "tar": "6.2.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "12.12.70",
    "@types/semver": "7.7.1",
    "@types/tar": "6.1.13",
    "core-js-compat": "3.49.0",
    "cross-env": "^10.0.0",
    "electron": "workspace:*",
    "electron-builder": "^26.15.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-solid": "^0.6.0",
    "tsx": "^4.19.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
