{
  "name": "lucent",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "as3": "pnpm run as3:bridge && pnpm run as3:build",
    "as3:bridge": "tsx scripts/gen-as3-bridge.ts",
    "as3:build": "tsx scripts/build-as3-swf.ts",
    "clean": "tsx scripts/clean.ts",
    "dev": "tsx scripts/dev-runner.ts dev",
    "dev:app": "tsx scripts/dev-runner.ts app",
    "dev:app:game": "tsx scripts/dev-runner.ts app --launch-mode game",
    "dev:app:manager": "tsx scripts/dev-runner.ts app --launch-mode manager",
    "dev:docs": "tsx scripts/dev-runner.ts docs",
    "dist:app": "tsx scripts/build-desktop-artifact.ts",
    "dist:app:all": "tsx scripts/build-desktop-artifact.ts --platform all",
    "dist:app:linux": "tsx scripts/build-desktop-artifact.ts --platform linux",
    "dist:app:mac": "tsx scripts/build-desktop-artifact.ts --platform mac",
    "dist:app:win": "tsx scripts/build-desktop-artifact.ts --platform win",
    "docgen": "tsx scripts/gen-script-types.ts && tsx scripts/docgen.ts",
    "icons:build": "tsx scripts/build-icons.ts",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "format": "oxfmt --check",
    "format:write": "oxfmt",
    "prepare": "effect-tsgo patch --oxlint",
    "release": "tsx scripts/release.ts",
    "release:validate": "tsx scripts/validate-release.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "pnpm test:scripts && pnpm -r --if-present test",
    "test:scripts": "vitest run scripts/release-logic.test.ts scripts/docgen-packages.test.ts scripts/process.test.ts",
    "test:watch": "pnpm -r --if-present test:watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:script-packages && pnpm -r typecheck",
    "typecheck:script-packages": "tsc6 -p script-packages/lucent-consumables/jsconfig.repo.json --noEmit && tsc6 -p script-packages/lucent-dailies/jsconfig.repo.json --noEmit"
  },
  "dependencies": {
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.3",
    "@effect/tsgo": "0.37.0",
    "@effect/vitest": "4.0.3",
    "@storybook/addon-themes": "10.5.10",
    "@types/node": "^24.12.2",
    "@types/semver": "7.7.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "asconfigc": "^1.9.0",
    "git-cliff": "^2.9.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "semver": "7.7.4",
    "shiki": "^4.3.1",
    "simple-icons": "^13.0.0",
    "solid-js": "1.9.12",
    "storybook": "10.5.10",
    "storybook-solidjs-vite": "10.7.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "7.3.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "^5.0.4"
  }
}
