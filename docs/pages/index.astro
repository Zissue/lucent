---
import Icon from "blume/components/Icon.astro";
import { withBase } from "blume/components/islands/base-path.ts";
import PlatformIcon from "../components/PlatformIcon.astro";
import StandaloneLayout from "../components/StandaloneLayout.astro";

const description =
  "Lucent is a cross-platform automation utility client for AdventureQuest Worlds.";
const downloadUrl = withBase("/download");
const docsUrl = withBase("/docs");
const iconUrl = withBase("/icon.svg");
const overviewScreenshotUrl = withBase("/screenshots/tabbed-overview.webp");
const overviewScreenshotAlt =
  "Lucent with tabbed accounts, mixed rendering modes, and group controls open";
const galleryItems = [
  {
    label: "Tabbed windows",
    images: [{ label: "Overview", alt: overviewScreenshotAlt, src: overviewScreenshotUrl }],
  },
  {
    label: "Standalone client",
    images: [{ label: "Overview", alt: "Lucent running a single AQW client fighting Nightmare Carnax", src: withBase("/screenshots/standalone-client.webp") }],
  },
  {
    label: "Account manager",
    images: [
      { label: "Launch", alt: "Account Manager with five accounts selected to launch daily.js using auto grid", src: withBase("/screenshots/account-manager-launch.webp") },
      { label: "Sessions", alt: "Account Manager showing six sessions across four windows with script statuses", src: withBase("/screenshots/account-manager-sessions.webp") },
    ],
  },
] as const;
---

<StandaloneLayout description={description} ogSlug="index" route="/" title="">
  <section class="not-prose" id="lucent-landing">
    <div class="landing-hero">
      <div class="landing-lockup">
        <img
          alt=""
          aria-hidden="true"
          draggable="false"
          height="40"
          src={iconUrl}
          width="40"
        />
        <span>Lucent</span>
      </div>

      <h1>Automation for the rest of us.</h1>
      <p class="landing-intro">
        AQW automation for macOS, Windows, and Linux. No Flash installation required.
      </p>

      <div class="landing-actions">
        <lucent-download-button
          class="landing-download-group"
          data-platform-preview-enabled={import.meta.env.DEV ? "" : undefined}
        >
          <a
            aria-describedby="download-note"
            aria-label="Download Lucent"
            class="landing-download"
            href={downloadUrl}
          >
            <span
              aria-hidden="true"
              class="landing-platform-icon"
              data-platform-icon="mac"
            >
              <PlatformIcon platform="mac" />
            </span>
            <span
              aria-hidden="true"
              class="landing-platform-icon"
              data-platform-icon="windows"
            >
              <PlatformIcon platform="windows" />
            </span>
            <span
              aria-hidden="true"
              class="landing-platform-icon"
              data-platform-icon="linux"
            >
              <PlatformIcon platform="linux" />
            </span>
            <span class="landing-download-label">
              <span data-landing-download-label>Download Lucent</span>
              <span aria-hidden="true" class="landing-download-label-compact">
                Download
              </span>
            </span>
          </a>
          <script is:inline>
            (() => {
              const menu = document.currentScript?.closest("lucent-download-button");
              const label = menu?.querySelector("[data-landing-download-label]");
              if (label === null || label === undefined) return;

              const preview = menu.hasAttribute("data-platform-preview-enabled")
                ? new URLSearchParams(window.location.search)
                    .get("platform")
                    ?.toLowerCase()
                : null;
              const userAgent = navigator.userAgent.toLowerCase();
              const platform =
                navigator.userAgentData?.platform?.toLowerCase() ?? userAgent;
              const mobile =
                /android|iphone|ipad|ipod/u.test(userAgent) ||
                (userAgent.includes("macintosh") && navigator.maxTouchPoints > 1);

              const detected = mobile
                ? null
                : platform.includes("windows")
                  ? "windows"
                  : platform.includes("mac")
                    ? "mac"
                    : platform.includes("linux")
                      ? "linux"
                      : null;
              const selected = ["mac", "windows", "linux"].includes(preview)
                ? preview
                : detected;
              const labels = { mac: "Mac", windows: "Windows", linux: "Linux" };
              const name = selected === null ? null : labels[selected];

              if (name !== null) {
                menu.dataset.downloadPlatform = selected;
                label.textContent = `Download for ${name}`;
                menu
                  .querySelector(".landing-download")
                  ?.setAttribute("aria-label", `Download Lucent for ${name}`);
              }
            })();
          </script>
        </lucent-download-button>

        <a class="landing-secondary" href={docsUrl}>
          <span>Read the docs</span>
          <Icon aria-hidden="true" name="arrow-right" size={16} />
        </a>
      </div>

      <p class="landing-note" id="download-note">
        <span>Unofficial client, use at your own risk.</span>
        <span>Exclusively tested on macOS.</span>
        <a href={downloadUrl}>See all downloads.</a>
      </p>
    </div>

    <lucent-product-gallery
      aria-label="Lucent product gallery"
      class="landing-gallery"
    >
      <div class="landing-gallery-frame">
        <img
          alt={galleryItems[0].images[0].alt}
          data-gallery-image
          data-no-zoom
          decoding="async"
          draggable="false"
          height="942"
          id="gallery-image"
          loading="eager"
          src={galleryItems[0].images[0].src}
          width="1392"
        />
        <div class="landing-comparison" data-comparison hidden>
          <img data-comparison-image data-no-zoom alt="" draggable="false" />
          <span class="landing-comparison-label landing-comparison-label--before" data-comparison-before></span>
          <span class="landing-comparison-label landing-comparison-label--after" data-comparison-after></span>
          <span class="landing-comparison-divider" aria-hidden="true"><span><Icon name="chevron-left" size={12} /><Icon name="chevron-right" size={12} /></span></span>
          <input data-comparison-range type="range" min="0" max="100" value="50" aria-label="Compare screenshots" />
        </div>
      </div>

      {galleryItems.map((item, index) => (
        <div data-gallery-variants={index} hidden>
          {item.images.map((image) => (
            <span data-gallery-src={image.src} data-gallery-alt={image.alt} data-gallery-label={image.label}></span>
          ))}
        </div>
      ))}

      <div
        aria-label="Choose a product view"
        class="landing-gallery-selector"
        data-gallery-active="0"
        data-gallery-selector
        role="group"
      >
        {
          galleryItems.map((item, index) => (
            <button
              aria-controls="gallery-image"
              aria-label={`Show ${item.label}`}
              aria-pressed={index === 0 ? "true" : "false"}
              data-gallery-index={index}
              tabindex={index === 0 ? 0 : -1}
              type="button"
            >
              <span class="sr-only">{item.label}</span>
            </button>
          ))
        }
      </div>
    </lucent-product-gallery>

    <section aria-labelledby="faq-heading" class="landing-faq">
      <h2 id="faq-heading">More about Lucent</h2>
      <div class="landing-faq-list">
        <details>
          <summary>
            <span>Is Lucent for me?</span>
            <Icon
              aria-hidden="true"
              class="landing-faq-icon"
              name="chevron-down"
              size={16}
            />
          </summary>
          <div class="landing-faq-answer">
            <p>
              Lucent is a smaller, mostly DIY toolkit. Skua or Grimlite may
              better satisfy your needs if you want similar scripting
              flexibility with a richer ecosystem and more ready-made scripts.
            </p>
          </div>
        </details>
        <details>
          <summary>
            <span>Is Flash Player required?</span>
            <Icon
              aria-hidden="true"
              class="landing-faq-icon"
              name="chevron-down"
              size={16}
            />
          </summary>
          <div class="landing-faq-answer">
            <p>
              No. As of v0.1.0-beta.1, Lucent runs on a{" "}
              <a href="https://github.com/toommyliu/ruffle/tree/e86a3fba0cfd80175a3538d6a81917c701e6bd45" rel="noreferrer" target="_blank">patched version of Ruffle Web</a>.
              The integration is experimental, but has worked well in testing.
              Please report any bugs you encounter.
            </p>
          </div>
        </details>
      </div>
    </section>
  </section>
</StandaloneLayout>

<style is:global>
  #lucent-landing {
    position: relative;
    width: min(72rem, calc(100vw - 1.5rem));
    margin-inline-start: 50%;
    padding-block: clamp(1.25rem, 3vw, 2.25rem) clamp(2.5rem, 5vw, 4rem);
    color: var(--color-foreground);
    transform: translateX(-50%);
  }

  #lucent-landing a {
    text-decoration: none;
  }

  #lucent-landing .landing-hero {
    position: relative;
    z-index: 10;
    max-width: 40rem;
  }

  #lucent-landing .landing-lockup {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  #lucent-landing .landing-lockup img {
    display: block;
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
    pointer-events: none;
    user-select: none;
  }

  #lucent-landing h1 {
    max-width: 20ch;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.02;
    text-wrap: balance;
  }

  #lucent-landing .landing-intro {
    max-width: 34rem;
    margin: 0.9rem 0 0;
    color: var(--color-muted-foreground);
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  #lucent-landing .landing-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  #lucent-landing .landing-download-group {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: stretch;
    border-radius: 9999px;
    background: var(--color-foreground);
    color: var(--color-background);
  }

  #lucent-landing .landing-download {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.625rem;
    border-radius: 9999px;
    padding-inline: 1.25rem;
    color: var(--color-background);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  #lucent-landing .landing-download-label-compact {
    display: none;
  }

  #lucent-landing .landing-platform-icon {
    display: none;
    width: 1.1875rem;
    height: 1.1875rem;
    flex: 0 0 1.1875rem;
    align-items: center;
    justify-content: center;
  }

  #lucent-landing .landing-platform-icon > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #lucent-landing
    .landing-download-group[data-download-platform="mac"]
    [data-platform-icon="mac"],
  #lucent-landing
    .landing-download-group[data-download-platform="windows"]
    [data-platform-icon="windows"],
  #lucent-landing
    .landing-download-group[data-download-platform="linux"]
    [data-platform-icon="linux"] {
    display: inline-flex;
  }

  #lucent-landing .landing-secondary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 9999px;
    padding-inline: 1.25rem;
    background: var(--color-muted);
    color: var(--color-foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  #lucent-landing .landing-note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.75rem 0 0;
    color: var(--color-muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  #lucent-landing .landing-note a {
    color: inherit;
    text-decoration: underline;
    text-decoration-skip-ink: auto;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.18em;
    text-underline-position: from-font;
  }

  #lucent-landing .landing-gallery {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: 1.25rem;
  }

  #lucent-landing .landing-gallery-frame {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-muted);
    isolation: isolate;
  }

  #lucent-landing .landing-gallery-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1392 / 942;
    object-fit: cover;
    user-select: none;
  }

  #lucent-landing .landing-comparison[hidden] {
    display: none;
  }

  #lucent-landing .landing-comparison {
    --comparison-position: 50%;
    position: absolute;
    inset: 0;
  }

  #lucent-landing .landing-comparison img {
    height: 100%;
    clip-path: inset(0 0 0 var(--comparison-position));
  }

  #lucent-landing .landing-comparison-divider {
    position: absolute;
    inset-block: 0;
    left: var(--comparison-position);
    width: 2px;
    transform: translateX(-50%);
    background: white;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  #lucent-landing .landing-comparison-divider span {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: white;
    color: black;
  }

  #lucent-landing .landing-comparison input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  #lucent-landing .landing-comparison:has(input:focus-visible) .landing-comparison-divider span {
    outline: 2px solid black;
    outline-offset: 3px;
  }

  #lucent-landing .landing-comparison-label {
    position: absolute;
    bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    background: rgb(17 17 17 / 75%);
    color: white;
    font-size: 0.75rem;
    pointer-events: none;
  }

  #lucent-landing .landing-comparison-label--before { left: 0.75rem; }
  #lucent-landing .landing-comparison-label--after { right: 0.75rem; }

  #lucent-landing .landing-gallery-selector {
    --gallery-index: 0;
    position: relative;
    order: -1;
    display: flex;
    width: max-content;
    justify-content: center;
    gap: 0.125rem;
    margin: 0 0 0.5rem;
  }

  #lucent-landing .landing-gallery-selector[data-gallery-active="1"] {
    --gallery-index: 1;
  }

  #lucent-landing .landing-gallery-selector[data-gallery-active="2"] {
    --gallery-index: 2;
  }

  #lucent-landing .landing-gallery-selector[data-gallery-active="3"] {
    --gallery-index: 3;
  }

  #lucent-landing .landing-gallery-selector::after {
    position: absolute;
    top: 0.5rem;
    inset-inline-start: 0.5rem;
    width: 1.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-foreground);
    content: "";
    pointer-events: none;
    transform: translateX(calc(var(--gallery-index) * 2.625rem));
  }

  #lucent-landing .landing-gallery-selector button {
    display: inline-flex;
    width: 2.5rem;
    height: 1.5rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9999px;
    padding: 0;
    background: transparent;
    color: var(--color-muted-foreground);
  }

  #lucent-landing .landing-gallery-selector button::before {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: currentColor;
    content: "";
    opacity: 0.45;
  }

  #lucent-landing
    .landing-gallery-selector
    button[aria-pressed="true"]::before {
    opacity: 0;
  }

  #lucent-landing .landing-faq {
    max-width: 48rem;
    margin: clamp(2.5rem, 4vw, 3.5rem) auto 0;
  }

  #lucent-landing .landing-faq > h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
  }

  #lucent-landing .landing-faq-list {
    overflow: hidden;
    margin-top: 1rem;
    border-radius: 0.875rem;
    background: color-mix(in oklab, var(--color-muted) 60%, transparent);
  }

  #lucent-landing .landing-faq summary {
    display: flex;
    min-height: 3.5rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  #lucent-landing .landing-faq summary::-webkit-details-marker {
    display: none;
  }

  #lucent-landing .landing-faq details[open] .landing-faq-icon {
    transform: rotate(180deg);
  }

  #lucent-landing .landing-faq-icon {
    flex: 0 0 auto;
    color: var(--color-muted-foreground);
  }

  #lucent-landing .landing-faq-answer {
    padding: 0 1rem 1rem;
  }

  #lucent-landing .landing-faq-answer p {
    max-width: 65ch;
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  #lucent-landing
    :is(
      .landing-download,
      .landing-secondary,
      .landing-faq summary,
      .landing-gallery-selector button
    ):focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    #lucent-landing .landing-download-group > a:hover {
      background: color-mix(
        in oklab,
        var(--color-background) 14%,
        transparent
      );
    }

    #lucent-landing .landing-secondary:hover {
      background: color-mix(
        in oklab,
        var(--color-muted) 84%,
        var(--color-foreground) 16%
      );
    }

    #lucent-landing .landing-gallery-selector button:hover::before {
      opacity: 0.8;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes landing-enter {
      from {
        opacity: 0;
        transform: translateY(0.375rem);
      }
    }

    #lucent-landing
      :is(
        .landing-lockup,
        h1,
        .landing-intro,
        .landing-actions,
        .landing-note,
        .landing-gallery
      ) {
      animation: landing-enter 400ms cubic-bezier(0.2, 0, 0, 1) both;
    }

    #lucent-landing h1 {
      animation-delay: 50ms;
    }

    #lucent-landing .landing-intro {
      animation-delay: 100ms;
    }

    #lucent-landing .landing-actions {
      animation-delay: 150ms;
    }

    #lucent-landing .landing-note {
      animation-delay: 190ms;
    }

    #lucent-landing .landing-gallery {
      animation-delay: 230ms;
    }

    #lucent-landing .landing-download-group > a,
    #lucent-landing .landing-secondary {
      transition: background-color 150ms ease;
    }

    #lucent-landing .landing-gallery-selector button {
      transition: scale 150ms ease;
    }

    #lucent-landing .landing-gallery-selector button::before {
      transition: opacity 150ms ease;
    }

    #lucent-landing .landing-gallery-selector::after {
      transition: transform 250ms cubic-bezier(0.2, 0, 0, 1);
    }

    #lucent-landing .landing-faq-icon {
      transition: transform 150ms ease;
    }

    #lucent-landing
      :is(
        .landing-download,
        .landing-secondary,
        .landing-gallery-selector button
      ):active {
      scale: 0.96;
    }
  }

  @media (min-width: 40rem) {
    #lucent-landing {
      width: min(72rem, calc(100vw - 2.5rem));
    }
  }

  @media (max-width: 42.499rem) {
    #lucent-landing .landing-download-label > [data-landing-download-label] {
      display: none;
    }

    #lucent-landing .landing-download-label-compact {
      display: inline;
    }
  }

  @media (max-width: 31.999rem) {
    #lucent-landing h1 {
      font-size: clamp(2rem, 10vw, 2.6rem);
    }

    #lucent-landing .landing-actions {
      align-items: stretch;
    }

    #lucent-landing .landing-download-group,
    #lucent-landing .landing-secondary {
      flex-grow: 1;
    }

    #lucent-landing .landing-download {
      flex: 1;
      justify-content: center;
    }

    #lucent-landing .landing-gallery-frame {
      border-radius: 0.875rem;
    }
  }
</style>

<script>
  import { downloads, fetchLatestRelease } from "../components/downloads.ts";

  const isArm = async (): Promise<boolean> => {
    if (/aarch64|arm64/u.test(navigator.userAgent.toLowerCase())) return true;

    const userAgentData: unknown = Reflect.get(navigator, "userAgentData");
    if (
      typeof userAgentData !== "object" || userAgentData === null ||
      !("getHighEntropyValues" in userAgentData) ||
      typeof userAgentData.getHighEntropyValues !== "function"
    ) return false;

    try {
      const values: unknown = await userAgentData.getHighEntropyValues(["architecture"]);
      return typeof values === "object" && values !== null &&
        "architecture" in values && values.architecture === "arm";
    } catch {
      return false;
    }
  };

  class LucentDownloadButton extends HTMLElement {
    async #resolveDownload(): Promise<void> {
      const platform = this.dataset.downloadPlatform;
      if (platform === undefined) return;

      const [release, arm] = await Promise.all([fetchLatestRelease(), isArm()]);
      const arch = platform === "mac" ? "universal" : arm ? "arm64" : "x64";
      const download = downloads.find((candidate) =>
        candidate.platform === platform && candidate.arch === arch,
      );
      const asset = download && release?.assets.get(download.suffix);
      const link = this.querySelector<HTMLAnchorElement>(".landing-download");
      if (asset && link && this.isConnected) link.href = asset.url;
    }

    connectedCallback(): void {
      void this.#resolveDownload();
    }
  }

  class LucentProductGallery extends HTMLElement {
    #buttons: HTMLButtonElement[] = [];
    #image: HTMLImageElement | null = null;
    #imageRequest = 0;
    #selector: HTMLElement | null = null;
    #snapComparison = false;

    #onPointerdown = (event: PointerEvent): void => {
      if (event.target instanceof HTMLInputElement && event.target.matches("[data-comparison-range]")) {
        this.#snapComparison = true;
      }
    };

    #onClick = (event: MouseEvent): void => {
      if (!(event.target instanceof Element)) return;

      const button = event.target.closest<HTMLButtonElement>(
        "[data-gallery-index]",
      );
      if (button === null || !this.contains(button)) return;

      this.#select(Number(button.dataset.galleryIndex));
    };

    #onKeydown = (event: KeyboardEvent): void => {
      this.#snapComparison = false;
      if (!(event.target instanceof HTMLButtonElement)) return;

      const current = this.#buttons.indexOf(event.target);
      if (current === -1) return;

      const last = this.#buttons.length - 1;
      const next =
        event.key === "ArrowRight"
          ? current === last
            ? 0
            : current + 1
          : event.key === "ArrowLeft"
            ? current === 0
              ? last
              : current - 1
            : event.key === "Home"
              ? 0
              : event.key === "End"
                ? last
                : null;

      if (next === null) return;

      event.preventDefault();
      this.#select(next, true);
    };

    #select(index: number, focus = false): void {
      const selected = this.#buttons[index];
      if (selected === undefined) return;

      this.#buttons.forEach((button, buttonIndex) => {
        const active = buttonIndex === index;
        button.setAttribute("aria-pressed", String(active));
        button.tabIndex = active ? 0 : -1;
      });

      if (this.#selector !== null) {
        this.#selector.dataset.galleryActive = String(index);
      }

      this.#showImages(index);

      if (focus) selected.focus();
    }

    #showImages(index: number): void {
      const sources = Array.from(this.querySelectorAll<HTMLElement>(`[data-gallery-variants="${index}"] [data-gallery-src]`));
      const first = sources[0];
      if (first === undefined) return;
      const request = ++this.#imageRequest;
      void Promise.all(sources.map((source) => {
        const image = new Image();
        image.src = source.dataset.gallerySrc ?? "";
        return image.decode();
      }))
        .then(() => {
          if (request !== this.#imageRequest || this.#image === null) return;
          this.#image.src = first.dataset.gallerySrc ?? "";
          this.#image.alt = first.dataset.galleryAlt ?? "";
          const comparison = this.querySelector<HTMLElement>("[data-comparison]");
          const afterImage = this.querySelector<HTMLImageElement>("[data-comparison-image]");
          const range = this.querySelector<HTMLInputElement>("[data-comparison-range]");
          const second = sources[1];
          if (comparison === null || afterImage === null || range === null) return;
          comparison.hidden = second === undefined;
          if (second === undefined) return;
          afterImage.src = second.dataset.gallerySrc ?? "";
          afterImage.alt = second.dataset.galleryAlt ?? "";
          const beforeLabel = first.dataset.galleryLabel ?? "Before";
          const afterLabel = second.dataset.galleryLabel ?? "After";
          const before = this.querySelector("[data-comparison-before]");
          const after = this.querySelector("[data-comparison-after]");
          if (before !== null) before.textContent = beforeLabel;
          if (after !== null) after.textContent = afterLabel;
          range.setAttribute("aria-label", `Compare ${beforeLabel} and ${afterLabel}`);
          range.value = "50";
          comparison.style.setProperty("--comparison-position", "50%");
        })
        .catch(() => undefined);
    }

    #onInput = (event: Event): void => {
      if (!(event.target instanceof HTMLInputElement) || !event.target.matches("[data-comparison-range]")) return;
      if (this.#snapComparison && Math.abs(event.target.valueAsNumber - 50) <= 3) {
        event.target.value = "50";
      }
      this.querySelector<HTMLElement>("[data-comparison]")?.style.setProperty("--comparison-position", `${event.target.value}%`);
    };

    connectedCallback(): void {
      this.#buttons = Array.from(
        this.querySelectorAll<HTMLButtonElement>("[data-gallery-index]"),
      );
      this.#image = this.querySelector("[data-gallery-image]");
      this.#selector = this.querySelector("[data-gallery-selector]");
      this.#select(0);
      this.addEventListener("click", this.#onClick);
      this.addEventListener("keydown", this.#onKeydown);
      this.addEventListener("input", this.#onInput);
      this.addEventListener("pointerdown", this.#onPointerdown);
    }

    disconnectedCallback(): void {
      this.removeEventListener("click", this.#onClick);
      this.removeEventListener("keydown", this.#onKeydown);
      this.removeEventListener("input", this.#onInput);
      this.removeEventListener("pointerdown", this.#onPointerdown);
      this.#buttons = [];
      this.#image = null;
      this.#imageRequest += 1;
      this.#selector = null;
    }
  }

  if (!customElements.get("lucent-download-button")) {
    customElements.define("lucent-download-button", LucentDownloadButton);
  }

  if (!customElements.get("lucent-product-gallery")) {
    customElements.define("lucent-product-gallery", LucentProductGallery);
  }
</script>
