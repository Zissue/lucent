---
import { EN_UI } from "blume/core/i18n-ui.ts";
import type { UIStrings } from "blume/core/i18n-ui.ts";
import type { Navigation } from "blume/core/types.ts";
import Icon from "blume/components/Icon.astro";
import { flattenPages } from "blume/components/layout/nav-utils.ts";

interface Props {
  askEnabled?: boolean;
  navigation?: Navigation;
  popularPages?: { icon?: string; label: string; route: string }[];
  strings?: UIStrings["search"];
  locale?: string;
}

const {
  askEnabled = false,
  navigation,
  popularPages,
  strings,
  locale,
} = Astro.props;
const s = { ...EN_UI.search, ...strings };
const pages = navigation ? flattenPages(navigation.sidebar) : [];
const popular =
  popularPages && popularPages.length > 0
    ? popularPages
    : pages.slice(0, 6);
const kbd = "rounded border border-border bg-muted px-1 py-0.5 font-mono";
---

<blume-search
  class="contents"
  data-ask={askEnabled ? "" : undefined}
  data-i18n-ask={s.askAi}
  data-i18n-ask-hint={s.askAiHint}
  data-i18n-dev={s.devOnly}
  data-i18n-empty={s.noResults}
  data-i18n-error={s.error}
  data-i18n-popular={s.popular}
  data-locale={locale || undefined}
>
  <button
    aria-label={s.button}
    class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-full border border-border bg-background px-3 text-muted-foreground text-sm transition-colors hover:border-foreground hover:text-foreground sm:min-w-48"
    data-blume-search-open
    type="button"
  >
    <Icon name="search" size={16} />
    <span class="flex-1 text-start max-sm:hidden">{s.button}</span>
    <kbd class="font-mono text-xs max-sm:hidden" data-blume-search-kbd>⌘K</kbd>
  </button>

  <dialog
    aria-label={s.label}
    class="mx-auto mt-[8vh] mb-auto h-[min(34rem,90dvh)] w-[min(48rem,94vw)] flex-col overflow-hidden rounded-blume border border-border bg-background p-0 text-foreground shadow-xl outline-none backdrop:bg-black/30 open:flex sm:mt-auto"
    data-blume-search-dialog
  >
    <div
      class="flex items-center gap-2.5 border-border border-b px-4 py-3 text-muted-foreground"
    >
      <Icon name="search" size={18} />
      <input
        aria-label={s.label}
        autocomplete="off"
        class="flex-1 border-0 bg-transparent text-foreground text-sm pointer-coarse:text-base focus:outline-none [&::-webkit-search-cancel-button]:appearance-none"
        data-blume-search-input
        placeholder={s.placeholder}
        type="search"
      />
      <kbd class={`${kbd} text-xs`}>Esc</kbd>
    </div>

    <div class="relative flex min-h-0 flex-1 flex-col">
      <div
        aria-label="Filter results"
        class="shrink-0 overflow-x-auto bg-background px-5 py-2"
        data-blume-search-filters
        hidden
        role="group"
      >
      </div>
      <div
        class="flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto p-2"
        data-blume-search-results
        role="listbox"
      >
      </div>
      <p
        class="pointer-events-none absolute inset-x-4 top-1/2 m-0 -translate-y-1/2 text-center text-muted-foreground text-sm"
        data-blume-search-message
        hidden
      >
      </p>
    </div>

    <div
      class="flex items-center justify-end gap-3 border-border border-t px-3 py-2 text-muted-foreground text-xs"
    >
      <span class="flex items-center gap-1">
        <kbd class={`${kbd} text-[0.65rem]`}>↑</kbd>
        <kbd class={`${kbd} text-[0.65rem]`}>↓</kbd>
        {s.navigate}
      </span>
      <span class="flex items-center gap-1">
        <kbd class={`${kbd} text-sm leading-none`}>↵</kbd>
        {s.open}
      </span>
    </div>
  </dialog>

  <script
    data-blume-search-popular
    is:inline
    set:html={JSON.stringify(popular).replaceAll("<", "\\u003c")}
    type="application/json"
  />
  <script
    data-blume-search-pages
    is:inline
    set:html={JSON.stringify(pages).replaceAll("<", "\\u003c")}
    type="application/json"
  />

  <script>
    import {
      joinBase,
      prefixBase,
    } from "blume/components/islands/base-path.ts";
    import {
      escapeHtml,
      highlight,
      matchSnippet,
    } from "blume/components/layout/search/types.ts";
    import type {
      SearchFn,
      SearchHit,
    } from "blume/components/layout/search/types.ts";

    interface Selectable {
      el: HTMLElement;
      kind: "ask" | "link";
      url?: string;
    }

    interface PopularPage {
      label: string;
      route: string;
    }

    type ResultKind =
      | "Guide"
      | "CLI"
      | "Type"
      | "Namespace"
      | "Module"
      | "Package"
      | "Reference";
    type ResultFilter = "Guides" | "APIs" | "Types" | "CLI";

    const ROW_CLASS =
      "flex w-full cursor-pointer items-start rounded-blume px-3 py-2.5 text-start text-inherit transition-colors hover:no-underline";
    const ROW_ON = ["bg-muted"];
    const MARK =
      "[&_mark]:rounded-sm [&_mark]:bg-accent/25 [&_mark]:text-inherit";
    const GENERATED_COMMENT = /<!--\s*Generated by.*?--(?:>|(?=\s))/giu;
    const DEFINED_IN = /\bDefined in\s+\S+:\d+\b/giu;
    const DIRECTIVE = /:::[\w-]+(?:\[[^\]]*\])?|:::/gu;
    const WHITESPACE = /\s+/gu;
    const FILTER_ORDER: readonly ResultFilter[] = [
      "Guides",
      "APIs",
      "Types",
      "CLI",
    ];

    /** Remove generator metadata that is useful on a page but noisy in a result row. */
    const cleanSearchText = (text: string): string =>
      text
        .replace(GENERATED_COMMENT, " ")
        .replace(DEFINED_IN, " ")
        .replace(DIRECTIVE, " ")
        .replace(WHITESPACE, " ")
        .trim();

    const titleCase = (value: string): string => {
      if (value === "api") {
        return "API";
      }
      if (value === "cli") {
        return "CLI";
      }
      const words = value.replaceAll("-", " ");
      return `${words.charAt(0).toUpperCase()}${words.slice(1)}`;
    };

    /** Prefer authored breadcrumbs, then derive a stable hierarchy from the route. */
    const breadcrumbFor = (hit: SearchHit): string[] => {
      if (hit.breadcrumb && hit.breadcrumb.length > 0) {
        return hit.breadcrumb.filter(
          (label, index, labels) =>
            index === 0 || label !== labels[index - 1],
        );
      }

      const segments = new URL(hit.url, window.location.origin).pathname
        .split("/")
        .filter(Boolean)
        .slice(0, -1);
      return segments.map(titleCase);
    };

    /** Give each result a user-facing kind instead of exposing index sections. */
    const kindFor = (url: string): ResultKind => {
      const path = new URL(url, window.location.origin).pathname.replace(
        /\/$/u,
        "",
      );
      if (path.startsWith("/docs/")) {
        return "Guide";
      }
      if (path === "/reference/cli") {
        return "CLI";
      }
      if (path.startsWith("/reference/scripting/types/")) {
        return "Type";
      }
      if (path.startsWith("/reference/scripting/api/")) {
        return "Namespace";
      }
      if (path.startsWith("/reference/scripting/packages/")) {
        return "Package";
      }
      if (
        path === "/reference/scripting" ||
        path === "/reference/scripting/api" ||
        path === "/reference/scripting/autorelogin" ||
        path === "/reference/scripting/autozone" ||
        path === "/reference/scripting/effect" ||
        path === "/reference/scripting/script"
      ) {
        return "Module";
      }
      return "Reference";
    };

    /** Group related result kinds into filters that reflect user intent. */
    const filterFor = (url: string): ResultFilter | null => {
      const kind = kindFor(url);
      if (kind === "Guide") {
        return "Guides";
      }
      if (kind === "Namespace" || kind === "Module" || kind === "Package") {
        return "APIs";
      }
      if (kind === "Type") {
        return "Types";
      }
      return kind === "CLI" ? "CLI" : null;
    };

    /** Search dialog with a single result stream and no source preview pane. */
    class BlumeSearch extends HTMLElement {
      dialog!: HTMLDialogElement;
      input!: HTMLInputElement;
      filters!: HTMLElement;
      results!: HTMLElement;
      message!: HTMLElement;
      searchFn: SearchFn | null = null;
      loaded = false;
      loadFailed = false;
      loading = false;
      askEnabled = false;
      popular: PopularPage[] = [];
      pages: PopularPage[] = [];
      selectables: Selectable[] = [];
      selectedIndex = -1;
      renderGeneration = 0;
      locale: string | null = null;
      filterQuery = "";
      activeFilter: ResultFilter | null = null;
      devOnlyMsg = "Search is available in the production build.";
      noResultsMsg = "No results found.";
      errorMsg = "Something went wrong. Please try again.";
      askMsg = "Ask AI";
      askHintMsg = "Get an instant answer from AI";
      popularMsg = "Popular";

      connectedCallback(): void {
        this.devOnlyMsg =
          this.getAttribute("data-i18n-dev") || this.devOnlyMsg;
        this.noResultsMsg =
          this.getAttribute("data-i18n-empty") || this.noResultsMsg;
        this.errorMsg = this.getAttribute("data-i18n-error") || this.errorMsg;
        this.askMsg = this.getAttribute("data-i18n-ask") || this.askMsg;
        this.askHintMsg =
          this.getAttribute("data-i18n-ask-hint") || this.askHintMsg;
        this.popularMsg =
          this.getAttribute("data-i18n-popular") || this.popularMsg;
        this.locale = this.getAttribute("data-locale");
        this.dialog = this.querySelector("[data-blume-search-dialog]")!;
        this.input = this.querySelector("[data-blume-search-input]")!;
        this.filters = this.querySelector("[data-blume-search-filters]")!;
        this.results = this.querySelector("[data-blume-search-results]")!;
        this.message = this.querySelector("[data-blume-search-message]")!;
        this.askEnabled = this.hasAttribute("data-ask");

        const popularScript = this.querySelector(
          "[data-blume-search-popular]",
        );
        const pagesScript = this.querySelector("[data-blume-search-pages]");
        try {
          this.popular = JSON.parse(popularScript?.textContent || "[]");
          this.pages = JSON.parse(pagesScript?.textContent || "[]");
        } catch {
          this.popular = [];
          this.pages = [];
        }

        const isApple = /mac|iphone|ipad|ipod/iu.test(navigator.platform);
        const hint = this.querySelector("[data-blume-search-kbd]");
        if (hint) {
          hint.textContent = isApple ? "⌘K" : "Ctrl K";
        }

        this.querySelector("[data-blume-search-open]")?.addEventListener(
          "click",
          () => this.open(),
        );
        document.addEventListener("keydown", (event) => {
          if (
            (event.key === "k" || event.key === "K") &&
            (event.metaKey || event.ctrlKey) &&
            !event.shiftKey &&
            !event.altKey
          ) {
            event.preventDefault();
            if (this.dialog.open) {
              this.dialog.close();
            } else {
              this.open();
            }
          } else if (event.key === "/" && !this.isField(event.target)) {
            event.preventDefault();
            this.open();
          }
        });

        this.input.addEventListener("input", () => this.render());
        this.dialog.addEventListener("keydown", (event) =>
          this.onKeydown(event),
        );
        this.dialog.addEventListener("click", (event) => {
          if (event.target === this.dialog) {
            this.dialog.close();
          }
        });
      }

      isField(target: EventTarget | null): boolean {
        const element = target as HTMLElement | null;
        return Boolean(
          element &&
            (element.tagName === "INPUT" ||
              element.tagName === "TEXTAREA" ||
              element.isContentEditable),
        );
      }

      async open(): Promise<void> {
        if (this.dialog.open) {
          return;
        }
        this.dialog.showModal();
        this.input.focus();
        this.input.select();
        if (!this.loaded) {
          this.loading = true;
          try {
            const { createSearch } = await import("./search/minisearch.ts");
            this.searchFn = await createSearch({
              indexUrl: joinBase(
                import.meta.env.BASE_URL ?? "/",
                "blume-search.json",
              ),
            });
            this.loaded = true;
            this.loadFailed = false;
          } catch {
            this.searchFn = null;
            this.loadFailed = !import.meta.env.DEV;
          } finally {
            this.loading = false;
          }
        }
        this.render();
      }

      onKeydown(event: KeyboardEvent): void {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          this.move(1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          this.move(-1);
        } else if (event.key === "Enter" && !event.isComposing) {
          const item = this.selectables[this.selectedIndex];
          if (item) {
            event.preventDefault();
            this.activate(item);
          }
        }
      }

      setMessage(text: string): void {
        this.message.textContent = text;
        this.message.hidden = !text;
      }

      async render(): Promise<void> {
        const query = this.input.value.trim();
        if (query !== this.filterQuery) {
          this.filterQuery = query;
          this.activeFilter = null;
        }
        this.renderGeneration += 1;
        const generation = this.renderGeneration;
        this.selectables = [];
        this.selectedIndex = -1;
        this.filters.replaceChildren();
        this.filters.hidden = true;
        this.results.replaceChildren();
        this.setMessage("");

        if (!query) {
          this.renderEmpty();
          this.finishRender();
          return;
        }

        if (!this.searchFn) {
          this.setMessage(
            this.loading
              ? "…"
              : this.loadFailed
                ? this.errorMsg
                : this.devOnlyMsg,
          );
          return;
        }

        let result: Awaited<ReturnType<SearchFn>>;
        try {
          result = await this.searchFn(query, {
            locale: this.locale ?? undefined,
          });
        } catch {
          if (generation === this.renderGeneration) {
            this.setMessage(this.errorMsg);
          }
          return;
        }
        if (generation !== this.renderGeneration) {
          return;
        }

        const hitRoutes = new Set(result.hits.map((hit) => hit.url));
        const normalizedQuery = query.toLocaleLowerCase();
        // Navigation title matches keep guides and namespace roots discoverable
        // when generated type names dominate the search provider's top results.
        const promotedPages = this.pages
          .filter(
            (page) =>
              page.label.toLocaleLowerCase().includes(normalizedQuery) &&
              !hitRoutes.has(page.route),
          )
          .toSorted((left, right) => {
            const leftLabel = left.label.toLocaleLowerCase();
            const rightLabel = right.label.toLocaleLowerCase();
            const leftStarts = leftLabel.startsWith(normalizedQuery) ? 0 : 1;
            const rightStarts = rightLabel.startsWith(normalizedQuery) ? 0 : 1;
            return leftStarts - rightStarts || leftLabel.localeCompare(rightLabel);
          })
          .slice(0, 2);

        const hits: SearchHit[] = [
          ...promotedPages.map((page) => ({
            breadcrumb: [],
            content: "",
            excerpt: "",
            title: highlight(page.label, query),
            url: page.route,
          })),
          ...result.hits,
        ];
        const filters = this.createFilterBar(hits);
        if (filters) {
          this.filters.appendChild(filters);
          this.filters.hidden = false;
        }

        if (this.askEnabled) {
          const ask = this.createAskRow(query);
          this.results.appendChild(ask.el);
          this.selectables.push(ask);
        }

        const visibleHits = this.activeFilter
          ? hits.filter((hit) => filterFor(hit.url) === this.activeFilter)
          : hits;
        for (const hit of visibleHits) {
          const item = this.createHitRow(hit, query);
          this.results.appendChild(item.el);
          this.selectables.push(item);
        }

        if (visibleHits.length === 0 && !this.askEnabled) {
          this.setMessage(this.noResultsMsg);
        }
        this.finishRender();
      }

      createFilterBar(hits: SearchHit[]): HTMLElement | null {
        const counts = new Map<ResultFilter, number>();
        for (const hit of hits) {
          const filter = filterFor(hit.url);
          if (filter) {
            counts.set(filter, (counts.get(filter) ?? 0) + 1);
          }
        }

        const available = FILTER_ORDER.filter((filter) => counts.has(filter));
        if (available.length < 2) {
          this.activeFilter = null;
          return null;
        }
        if (this.activeFilter && !counts.has(this.activeFilter)) {
          this.activeFilter = null;
        }

        const element = document.createElement("div");
        element.className = "flex gap-1.5";

        const options: { count: number; filter: ResultFilter | null; label: string }[] = [
          { count: hits.length, filter: null, label: "All" },
          ...available.map((filter) => ({
            count: counts.get(filter) ?? 0,
            filter,
            label: filter,
          })),
        ];
        for (const option of options) {
          const active = option.filter === this.activeFilter;
          const button = document.createElement("button");
          button.type = "button";
          button.className = `inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs transition-colors ${
            active
              ? "border-foreground bg-foreground text-background"
              : "border-border bg-background text-muted-foreground hover:border-foreground hover:text-foreground"
          }`;
          button.setAttribute("aria-pressed", String(active));

          const label = document.createElement("span");
          label.textContent = option.label;
          const count = document.createElement("span");
          count.className = "tabular-nums opacity-70";
          count.textContent = String(option.count);
          button.append(label, count);
          button.addEventListener("click", () => {
            this.activeFilter = option.filter;
            this.render();
          });
          element.appendChild(button);
        }

        return element;
      }

      renderEmpty(): void {
        if (this.askEnabled) {
          const ask = this.createAskRow("");
          this.results.appendChild(ask.el);
          this.selectables.push(ask);
        }
        if (this.popular.length === 0) {
          return;
        }

        const label = document.createElement("p");
        label.className =
          "m-0 px-3 pt-2 pb-1 text-muted-foreground text-xs";
        label.textContent = this.popularMsg;
        this.results.appendChild(label);

        for (const page of this.popular) {
          const item = this.createPopularRow(page);
          this.results.appendChild(item.el);
          this.selectables.push(item);
        }
      }

      createAskRow(query: string): Selectable {
        const element = document.createElement("button");
        element.type = "button";
        element.className = `${ROW_CLASS} ${MARK}`;
        const title = query
          ? `${escapeHtml(this.askMsg)}: <span class="text-muted-foreground">“${escapeHtml(query)}”</span>`
          : escapeHtml(this.askMsg);
        element.innerHTML = `
          <span class="min-w-0 flex-1">
            <span class="block truncate font-medium text-foreground text-sm">${title}</span>
            <span class="mt-0.5 block truncate text-muted-foreground text-xs">${escapeHtml(this.askHintMsg)}</span>
          </span>`;
        const item: Selectable = { el: element, kind: "ask" };
        this.bindRow(item);
        return item;
      }

      createHitRow(hit: SearchHit, query: string): Selectable {
        const element = document.createElement("a");
        const href = prefixBase(import.meta.env.BASE_URL, hit.url);
        const breadcrumb = breadcrumbFor(hit);
        const path = breadcrumb.length
          ? `<span class="truncate">${escapeHtml(breadcrumb.join(" / "))}</span>`
          : "";
        const kind = kindFor(hit.url);
        const content = cleanSearchText(hit.content ?? "");
        const excerpt =
          hit.content === undefined
            ? hit.excerpt
            : content
              ? highlight(matchSnippet(content, query, 180), query)
              : "";

        element.href = href;
        element.className = `${ROW_CLASS} ${MARK}`;
        element.setAttribute("role", "option");
        element.innerHTML = `
          <span class="min-w-0 flex-1">
            <span class="flex min-w-0 items-center gap-2">
              <span class="min-w-0 flex-1 truncate font-medium text-foreground text-sm">${hit.title}</span>
              <span class="shrink-0 rounded-full bg-muted px-2 py-0.5 text-muted-foreground text-xs">${escapeHtml(kind)}</span>
            </span>
            ${path ? `<span class="mt-0.5 flex min-w-0 text-muted-foreground text-xs">${path}</span>` : ""}
            ${
              excerpt
                ? `<span class="mt-1 line-clamp-2 text-muted-foreground text-sm leading-5">${excerpt}</span>`
                : ""
            }
          </span>`;
        const item: Selectable = { el: element, kind: "link", url: href };
        this.bindRow(item);
        return item;
      }

      createPopularRow(page: PopularPage): Selectable {
        const element = document.createElement("a");
        const href = prefixBase(import.meta.env.BASE_URL, page.route);
        element.href = href;
        element.className = ROW_CLASS;
        element.setAttribute("role", "option");
        element.innerHTML = `
          <span class="min-w-0 flex-1 truncate font-medium text-foreground text-sm">${escapeHtml(page.label)}</span>`;
        const item: Selectable = { el: element, kind: "link", url: href };
        this.bindRow(item);
        return item;
      }

      bindRow(item: Selectable): void {
        item.el.addEventListener("mouseenter", () => {
          this.selectIndex(this.selectables.indexOf(item));
        });
        if (item.kind === "ask") {
          item.el.addEventListener("click", (event) => {
            event.preventDefault();
            this.activate(item);
          });
        }
      }

      finishRender(): void {
        if (this.selectables.length > 0) {
          this.selectIndex(0);
        }
      }

      selectIndex(index: number): void {
        if (index < 0 || index >= this.selectables.length) {
          return;
        }
        const current = this.selectables[this.selectedIndex];
        if (current) {
          current.el.classList.remove(...ROW_ON);
          current.el.setAttribute("aria-selected", "false");
        }
        this.selectedIndex = index;
        const next = this.selectables[index];
        next.el.classList.add(...ROW_ON);
        next.el.setAttribute("aria-selected", "true");
        next.el.scrollIntoView({ block: "nearest" });
      }

      move(delta: number): void {
        if (this.selectables.length === 0) {
          return;
        }
        const max = this.selectables.length - 1;
        this.selectIndex(
          Math.min(max, Math.max(0, this.selectedIndex + delta)),
        );
      }

      activate(item: Selectable): void {
        if (item.kind === "ask") {
          const query = this.input.value.trim();
          this.dialog.close();
          window.dispatchEvent(
            new CustomEvent("blume:open-ask-ai", { detail: { query } }),
          );
        } else if (item.url) {
          window.location.href = item.url;
        }
      }
    }

    if (!customElements.get("blume-search")) {
      customElements.define("blume-search", BlumeSearch);
    }
  </script>
</blume-search>

<style is:global>
  /* Modal dialogs make the page inert but do not prevent background scrolling. */
  html:has(dialog[data-blume-search-dialog][open]) {
    overflow: hidden;
  }
</style>
