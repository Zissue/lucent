{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "ignorePatterns": [
    "node_modules",
    ".git",
    ".repos",
    ".repos/**",
    "dist",
    "build",
    "/scripts",
    "app/scripts",
    "packages/*/scripts",
    "*.tsbuildinfo"
  ],
  "plugins": ["eslint", "oxc", "unicorn", "typescript"],
  "jsPlugins": ["./packages/oxlint-plugin-lucent/index.js"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Import Effect namespaces from explicit subpaths such as effect/Effect."
          }
        ]
      }
    ],
    "lucent/no-inline-schema-compile": "warn",
    "lucent/no-manual-effect-runtime-in-tests": "error"
  },
  "overrides": [
    {
      "files": ["app/src/shared/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "message": "Import Effect namespaces from explicit subpaths such as effect/Effect."
              }
            ],
            "patterns": [
              {
                "regex": "^(\\.\\./)+(main|renderer)(/|$)",
                "message": "shared/ runs in every process. It must not import main or renderer code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["app/src/main/electron/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "message": "Import Effect namespaces from explicit subpaths such as effect/Effect."
              }
            ],
            "patterns": [
              {
                "regex": "^\\.\\./[^.]",
                "message": "electron/ holds thin Electron adapters. Import only electron/, shared/, and packages."
              },
              {
                "regex": "^\\.\\./\\.\\./(main|renderer)(/|$)",
                "message": "electron/ holds thin Electron adapters. Import only electron/, shared/, and packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["script-packages/*/scripts/**/*.js"],
      "rules": {
        "lucent/static-script-inputs": "error"
      }
    }
  ]
}
